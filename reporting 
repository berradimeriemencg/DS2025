        "# 🔹 Import des librairies\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import zipfile\n",
        "import os\n",
        "from google.colab import files\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# 🔹 Étape 1 : Upload du fichier (ZIP ou CSV)\n",
        "print(\"📂 Téléversez votre fichier CSV ou ZIP contenant le dataset\")\n",
        "uploaded = files.upload()  # Choisir le fichier\n",
        "\n",
        "# 🔹 Récupérer le nom du fichier téléversé\n",
        "file_name = list(uploaded.keys())[0]\n",
        "print(f\"Fichier téléversé : {file_name}\")\n",
        "\n",
        "# 🔹 Étape 2 : Extraction si ZIP\n",
        "extract_folder = 'dataset'\n",
        "if file_name.endswith('.zip'):\n",
        "    with zipfile.ZipFile(file_name, 'r') as zip_ref:\n",
        "        zip_ref.extractall(extract_folder)\n",
        "    print(f\"Fichiers extraits dans : {extract_folder}\")\n",
        "    # Récupération du CSV dans le dossier extrait\n",
        "    csv_file = [f for f in os.listdir(extract_folder) if f.endswith('.csv')][0]\n",
        "    csv_path = os.path.join(extract_folder, csv_file)\n",
        "else:\n",
        "    csv_path = file_name  # Si c'est directement un CSV\n",
        "\n",
        "# 🔹 Étape 3 : Lecture du CSV\n",
        "df = pd.read_csv(csv_path)\n",
        "print(\"\\n✅ Lecture du CSV terminée !\")\n",
        "print(\"Shape du dataset :\", df.shape)\n",
        "print(\"Colonnes :\", df.columns.tolist())\n",
        "\n",
        "# 🔹 Étape 4 : Conversion minimale (exemple)\n",
        "for col in ['Gender', 'Disease']:\n",
        "    if col in df.columns:\n",
        "        df[col] = df[col].astype('category')\n",
        "\n",
        "# 🔹 Étape 5 : Génération automatique du reporting Markdown\n",
        "def generate_report(df, csv_path):\n",
        "    import os\n",
        "    dataset_shape = df.shape\n",
        "    columns_list = df.columns.tolist()\n",
        "    missing_values = df.isnull().sum()\n",
        "    numeric_cols = df.select_dtypes(include=['number']).columns.tolist()\n",
        "    category_cols = df.select_dtypes(['category']).columns.tolist()\n",
        "\n",
        "    report = f\"# 📊 Reporting – Public Data Analysis\\n\\n\"\n",
        "\n",
        "    report += \"## 1. Présentation du Dataset\\n\"\n",
        "    report += f\"- **Nom du fichier :** {os.path.basename(csv_path)}\\n\"\n",
        "    report += f\"- **Nombre d'observations :** {dataset_shape[0]}\\n\"\n",
        "    report += f\"- **Nombre de colonnes / features :** {dataset_shape[1]}\\n\\n\"\n",
        "\n",
        "    report += \"## 2. Colonnes présentes\\n\"\n",
        "    report += f\"{columns_list}\\n\\n\"\n",
        "\n",
        "    report += \"## 3. Valeurs manquantes par colonne\\n\"\n",
        "    report += f\"{missing_values.to_dict()}\\n\\n\"\n",
        "\n",
        "    report += \"## 4. Statistiques descriptives (colonnes numériques)\\n\"\n",
        "    if numeric_cols:\n",
        "        report += f\"{df[numeric_cols].describe().to_dict()}\\n\\n\"\n",
        "    else:\n",
        "        report += \"Aucune colonne numérique.\\n\\n\"\n",
        "\n",
        "    report += \"## 5. Répartition des variables catégorielles\\n\"\n",
        "    for col in category_cols:\n",
        "        report += f\"### {col}\\n{df[col].value_counts().to_dict()}\\n\\n\"\n",
        "\n",
        "    report += \"## 6. Conclusion\\n\"\n",
        "    report += (\"Le dataset a été nettoyé et préparé. \"\n",
        "               \"Il est prêt pour l'analyse exploratoire, la visualisation \"\n",
        "               \"ou l'entraînement de modèles de Machine Learning.\\n\")\n",
        "\n",
        "    return report\n",
        "\n",
        "# 🔹 Appel de la fonction pour générer le rapport\n",
        "report_markdown = generate_report(df, csv_path)\n",
        "\n",
        "# 🔹 Affichage du rapport\n",
        "print(report_markdown)\n",
        "\n",
        "# 🔹 Sauvegarde du rapport dans un fichier Markdown\n",
        "with open(\"report.md\", \"w\", encoding=\"utf-8\") as f:\n",
        "    f.write(report_markdown)\n",
        "print(\"\\n✅ Le rapport a été sauvegardé dans 'report.md'.\")\n"
